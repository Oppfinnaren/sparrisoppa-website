# Caddy serves the site and handles HTTPS certificates automatically.
# Put this in /etc/caddy/Caddyfile (or import it), then: sudo systemctl reload caddy

yourname.se {
	root * /var/www/yourname.se
	encode zstd gzip
	file_server

	# Hugo writes a 404.html at the site root.
	handle_errors {
		@404 expression {err.status_code} == 404
		rewrite @404 /404.html
		file_server
	}

	# Fingerprinted CSS and fonts never change; cache them for a year.
	@immutable path /css/* /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
}

# Send www to the bare domain.
www.yourname.se {
	redir https://yourname.se{uri} permanent
}
